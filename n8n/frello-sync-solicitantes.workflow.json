        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Frello · Leer personas",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Frello · Leer personas": {
      "main": [
        [
          {
            "node": "Preparar lista",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar lista": {
      "main": [
        [
          {
            "node": "Farrusel · Guardar lista",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Farrusel · Guardar lista": {
      "main": [
        [
          {
            "node": "Farrusel · Desactivar ausentes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
